<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stressRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lab_bg"
    tools:context=".StressTestActivity">

    <!-- ===== CABEÇALHO ===== -->
    <LinearLayout
        android:id="@+id/stressHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="STRESS LAB"
                android:textColor="@color/lab_amber"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// CPU · RAM · GARBAGE COLLECTOR"
                android:textAppearance="@style/TextAppearance.RGraphX.Label" />
        </LinearLayout>

        <TextView
            android:id="@+id/chipStressBuild"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="DEBUG"
            android:textColor="@color/lab_amber"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ===== BOTÃO PRINCIPAL ===== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        style="@style/Widget.RGraphX.LabButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:text="▶ START · ESCALONAMENTO 640x480 → 8000x6000"
        android:textColor="@color/lab_bg"
        android:textSize="13sp"
        app:backgroundTint="@color/lab_amber"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stressHeader"
        app:strokeColor="@color/lab_amber" />

    <!-- ===== OUTROS TESTES ===== -->
    <LinearLayout
        android:id="@+id/stressActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnStart">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDataset"
            style="@style/Widget.RGraphX.LabButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="DATASET"
            android:textColor="@color/lab_blue"
            app:strokeColor="@color/lab_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeak"
            style="@style/Widget.RGraphX.LabButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="MEMORY LEAK"
            android:textColor="@color/lab_red"
            app:strokeColor="@color/lab_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            style="@style/Widget.RGraphX.LabButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="EXPORTAR CSV"
            android:textColor="@color/lab_green"
            app:strokeColor="@color/lab_green" />
    </LinearLayout>

    <!-- ===== PROGRESSO E TEMPO AO VIVO ===== -->
    <LinearLayout
        android:id="@+id/progressCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stressActions">

        <TextView
            android:id="@+id/txtStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="> AGUARDANDO TESTE..."
            android:textColor="@color/lab_text"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progressStress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/lab_stroke"
            android:progressTint="@color/lab_amber" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TEMPO DA ETAPA"
                    android:textAppearance="@style/TextAppearance.RGraphX.Label" />

                <TextView
                    android:id="@+id/txtLiveTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 ms"
                    android:textAppearance="@style/TextAppearance.RGraphX.Metric"
                    android:textColor="@color/lab_amber" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEAP NATIVO"
                    android:textAppearance="@style/TextAppearance.RGraphX.Label" />

                <TextView
                    android:id="@+id/txtLiveNative"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— MB"
                    android:textAppearance="@style/TextAppearance.RGraphX.Metric"
                    android:textColor="@color/lab_cyan" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEAP JAVA"
                    android:textAppearance="@style/TextAppearance.RGraphX.Label" />

                <TextView
                    android:id="@+id/txtLiveJava"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— MB"
                    android:textAppearance="@style/TextAppearance.RGraphX.Metric"
                    android:textColor="@color/lab_purple" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== TABELA DE RESULTADOS ===== -->
    <TextView
        android:id="@+id/lblResults"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="RESULTADOS (deslize para os lados)"
        android:textAppearance="@style/TextAppearance.RGraphX.Label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressCard" />

    <ScrollView
        android:id="@+id/resultsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/stressConsole"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblResults">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Nenhum teste executado ainda."
                android:textColor="@color/lab_text"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </HorizontalScrollView>
    </ScrollView>

    <!-- ===== CONSOLE ===== -->
    <ScrollView
        android:id="@+id/stressConsole"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_console"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/txtStressConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/lab_console_text"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
