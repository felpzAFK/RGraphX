<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lab_bg"
    tools:context=".MainActivity">

    <!-- ===== CABEÇALHO ===== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="RGraphX"
                android:textColor="@color/lab_green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// IMAGE LAB · NDK + OpenCV"
                android:textAppearance="@style/TextAppearance.RGraphX.Label" />
        </LinearLayout>

        <TextView
            android:id="@+id/chipNdk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="● NDK"
            android:textColor="@color/lab_green"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/chipBuild"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="DEBUG"
            android:textColor="@color/lab_amber"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ===== TELEMETRIA AO VIVO ===== -->
    <LinearLayout
        android:id="@+id/telemetryCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblLastExec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ÚLTIMA EXECUÇÃO"
                    android:textAppearance="@style/TextAppearance.RGraphX.Label" />

                <TextView
                    android:id="@+id/txtLastExec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— ms"
                    android:textAppearance="@style/TextAppearance.RGraphX.Metric"
                    android:textColor="@color/lab_green" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESOLUÇÃO"
                    android:textAppearance="@style/TextAppearance.RGraphX.Label" />

                <TextView
                    android:id="@+id/txtResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textAppearance="@style/TextAppearance.RGraphX.Metric" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEAP NATIVO (C++)"
                    android:textAppearance="@style/TextAppearance.RGraphX.Label" />

                <TextView
                    android:id="@+id/txtNativeHeap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— MB"
                    android:textAppearance="@style/TextAppearance.RGraphX.Metric"
                    android:textColor="@color/lab_cyan" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEAP JAVA (KOTLIN)"
                    android:textAppearance="@style/TextAppearance.RGraphX.Label" />

                <TextView
                    android:id="@+id/txtJavaHeap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— MB"
                    android:textAppearance="@style/TextAppearance.RGraphX.Metric"
                    android:textColor="@color/lab_purple" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="> AWAITING_EXECUTION..."
            android:textColor="@color/lab_green"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===== IMAGEM ===== -->
    <FrameLayout
        android:id="@+id/imageCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:padding="6dp"
        app:layout_constraintBottom_toTopOf="@id/buttonGrid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/telemetryCard">

        <ImageView
            android:id="@+id/imgLab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Imagem em processamento"
            android:scaleType="fitCenter"
            android:src="@drawable/rgraphicon" />

        <TextView
            android:id="@+id/txtImageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:background="@drawable/bg_overlay"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="ORIGINAL"
            android:textColor="@color/lab_text"
            android:textSize="10sp" />
    </FrameLayout>

    <!-- ===== FERRAMENTAS ===== -->
    <LinearLayout
        android:id="@+id/buttonGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/consolePanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPick"
                style="@style/Widget.RGraphX.LabButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="CARREGAR"
                android:textColor="@color/lab_blue"
                app:strokeColor="@color/lab_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProcess"
                style="@style/Widget.RGraphX.LabButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="GRAY C++"
                android:textColor="@color/lab_green"
                app:strokeColor="@color/lab_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKotlin"
                style="@style/Widget.RGraphX.LabButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="GRAY KT"
                android:textColor="@color/lab_purple"
                app:strokeColor="@color/lab_purple" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdge"
                style="@style/Widget.RGraphX.LabButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="CANNY"
                android:textColor="@color/lab_cyan"
                app:strokeColor="@color/lab_cyan" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBenchmark"
                style="@style/Widget.RGraphX.LabButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="BENCH"
                android:textColor="@color/lab_amber"
                app:strokeColor="@color/lab_amber" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStress"
                style="@style/Widget.RGraphX.LabButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="CPU STR"
                android:textColor="@color/lab_red"
                app:strokeColor="@color/lab_red" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.RGraphX.LabButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="RESET"
                android:textColor="@color/lab_text_dim"
                app:strokeColor="@color/lab_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLab"
                style="@style/Widget.RGraphX.LabButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="STRESS LAB ▶"
                android:textColor="@color/lab_bg"
                app:backgroundTint="@color/lab_amber"
                app:strokeColor="@color/lab_amber" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== CONSOLE ===== -->
    <ScrollView
        android:id="@+id/consolePanel"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_console"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/txtConsoleOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/lab_console_text"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
