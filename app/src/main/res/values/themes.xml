<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema escuro fixo: o app é um "terminal de laboratório" -->
    <style name="Base.Theme.RGraphX" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lab_green</item>
        <item name="colorOnPrimary">@color/lab_bg</item>
        <item name="colorSecondary">@color/lab_cyan</item>
        <item name="android:colorBackground">@color/lab_bg</item>
        <item name="android:windowBackground">@color/lab_bg</item>
        <item name="colorSurface">@color/lab_surface</item>
        <item name="colorOnSurface">@color/lab_text</item>
    </style>

    <style name="Theme.RGraphX" parent="Base.Theme.RGraphX" />

    <!-- Botões do painel de ferramentas -->
    <style name="Widget.RGraphX.LabButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:maxLines">2</item>
        <item name="cornerRadius">6dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/lab_surface_2</item>
    </style>

    <!-- Rótulo pequeno (ex.: "HEAP NATIVO") -->
    <style name="TextAppearance.RGraphX.Label" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/lab_text_dim</item>
    </style>

    <!-- Valor de telemetria (ex.: "42.17 ms") -->
    <style name="TextAppearance.RGraphX.Metric" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lab_text</item>
    </style>
</resources>
